#!/usr/bin/env bash
set -euo pipefail

LIB_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/my-router-lib.sh
source "$LIB_DIR/my-router-lib.sh"

with_office=0

usage() {
  cat <<'EOF'
usage: my-router-render-dry-run [--with-office]

Render miople configs into a temporary directory. This does not write /etc,
/var/lib, /opt, systemd units, WireGuard interfaces, nftables, or netns state.
EOF
}

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --with-office)
      with_office=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

replace_line() {
  local file="$1"
  local key="$2"
  local value="$3"
  local escaped
  escaped="$(printf '%s\n' "$value" | sed -e 's/[\/&]/\\&/g')"
  sed -i "s/^${key}=.*/${key}=${escaped}/" "$file"
}

genkey() {
  local path="$1"
  umask 077
  if command -v wg >/dev/null 2>&1; then
    wg genkey >"$path"
  else
    printf '%s\n' 'qLQsSxC4Ay+ti1dsnynt4fQjJxj+ZE08oMiYkQLpEWQ=' >"$path"
  fi
  chmod 0600 "$path"
}

main() {
  local share tmp config env access_key office_key office_public
  share="$(share_dir)"
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/my-router-render.XXXXXX")"
  config="$tmp/config"
  env="$config/miople.env"
  access_key="$config/secrets/wg-access.key"
  office_key="$config/secrets/wg-office.key"

  install -d -m 0755 "$config" "$config/rules" "$tmp/state/www" "$tmp/wireguard"
  install -d -m 0700 "$config/secrets"
  install -m 0640 "$share/hosts/miople/miople.env.example" "$env"
  install -m 0640 "$share/hosts/miople/wg-access-peers.conf.example" "$config/wg-access-peers.conf"
  install -m 0644 "$share/rules/sources.toml.example" "$config/rules/sources.toml"

  genkey "$access_key"
  genkey "$office_key"
  if command -v wg >/dev/null 2>&1; then
    office_public="$(wg pubkey <"$office_key")"
  else
    office_public="7EDmkU6G6ZbB0q2w1Vjz6jwVOobZBgjJq7d7Y4vQXBQ="
  fi

  replace_line "$env" MY_ROUTER_CONFIG_DIR "$config"
  replace_line "$env" MY_ROUTER_STATE_DIR "$tmp/state"
  replace_line "$env" MY_ROUTER_WWW_DIR "$tmp/state/www"
  replace_line "$env" WIREGUARD_DIR "$tmp/wireguard"
  replace_line "$env" PUBLISH_BIND ":18080"
  replace_line "$env" PUBLISH_PORT "18080"
  replace_line "$env" PUBLISH_TOKEN "dry-run-token"
  replace_line "$env" PUBLISH_BASE_URL "http://127.0.0.1:18080/dry-run-token"
  replace_line "$env" WG_ACCESS_PRIVATE_KEY_FILE "$access_key"
  replace_line "$env" WG_ACCESS_PEERS_FILE "$config/wg-access-peers.conf"
  replace_line "$env" WG_OFFICE_ENABLED "$with_office"
  replace_line "$env" WG_OFFICE_PRIVATE_KEY_FILE "$office_key"
  replace_line "$env" WG_OFFICE_PEER_PUBLIC_KEY "$office_public"
  replace_line "$env" WG_OFFICE_ENDPOINT "office.example.com:51820"
  replace_line "$env" MY_ROUTER_RULES_CONFIG "$config/rules/sources.toml"

  info "rendering into $tmp"
  MY_ROUTER_ALLOW_NON_ROOT=1 MY_ROUTER_ENV="$env" "$LIB_DIR/my-router-render"

  info "validating example rule TOML"
  python3 "$LIB_DIR/my-router-rules-build.py" --check "$config/rules/sources.toml"

  if command -v nft >/dev/null 2>&1; then
    if nft -c -f "$config/nftables.conf" >/dev/null 2>&1; then
      ok_msg="nftables syntax check passed"
    else
      ok_msg="nftables syntax check could not run here; inspect $config/nftables.conf"
    fi
    info "$ok_msg"
  fi

  info "generated files"
  find "$tmp" -maxdepth 5 -type f | sort
  info "dry-run output kept at $tmp"
}

main "$@"
