# Copy to /etc/my-router/miople.env on miople and edit there.

MY_ROUTER_HOSTNAME=miople
MY_ROUTER_CONFIG_DIR=/etc/my-router
MY_ROUTER_STATE_DIR=/var/lib/my-router
MY_ROUTER_WWW_DIR=/var/lib/my-router/www
WIREGUARD_DIR=/etc/wireguard

# Public interface and baseline access.
EXT_IF=eth0
SSH_PORT=22
PUBLISH_BIND=:8080
PUBLISH_PORT=8080
# For automatic HTTPS, set this to a real hostname instead, for example:
# PUBLISH_BIND=vpn.example.com
PUBLISH_TOKEN=change-this-long-random-token
PUBLISH_BASE_URL=https://vpn.example.com/change-this-long-random-token

# Client access WireGuard.
WG_ACCESS_IF=wg-access
WG_ACCESS_ADDRESS=10.77.0.1/24
WG_ACCESS_CIDR=10.77.0.0/24
WG_ACCESS_PORT=51820
WG_ACCESS_PRIVATE_KEY_FILE=/etc/my-router/secrets/wg-access.key
WG_ACCESS_PEERS_FILE=/etc/my-router/wg-access-peers.conf

# Office WireGuard client. Keep AllowedIPs limited to office/internal prefixes.
WG_OFFICE_ENABLED=0
WG_OFFICE_IF=wg-office
WG_OFFICE_ADDRESS=10.88.0.2/32
WG_OFFICE_PRIVATE_KEY_FILE=/etc/my-router/secrets/wg-office.key
WG_OFFICE_PEER_PUBLIC_KEY=
WG_OFFICE_ENDPOINT=office.example.com:51820
WG_OFFICE_ALLOWED_IPS=10.20.0.0/16,10.30.0.0/16
WG_OFFICE_PERSISTENT_KEEPALIVE=25

# RWTH OpenConnect inside a network namespace.
RWTH_ENABLED=1
RWTH_NETNS=rwth
RWTH_HOST_IF=vrwth-host
RWTH_NS_IF=vrwth-ns
RWTH_HOST_ADDRESS=10.78.0.1/30
RWTH_NS_ADDRESS=10.78.0.2/30
RWTH_HOST_IP=10.78.0.1
RWTH_NS_IP=10.78.0.2
RWTH_NETNS_CIDR=10.78.0.0/30
RWTH_GATEWAY=vpn.rwth-aachen.de
RWTH_AUTHGROUP="RWTH-VPN (Split Tunnel)"
RWTH_USER=ab123456
RWTH_DNS=1.1.1.1
RWTH_CIDRS=134.61.0.0/16,134.130.0.0/16,137.226.0.0/16,192.35.229.0/24
RWTH_ROUTE_USERS=

# Rule publisher.
MY_ROUTER_RULES_CONFIG=/etc/my-router/rules/sources.toml
